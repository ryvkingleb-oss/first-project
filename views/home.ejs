<%- include('partials/head', { title, wide: true }) %>
<section class="intro">
  <p class="kicker">Наряд</p>
  <h1>Клиент оставляет заявку, прораб ведёт квартиру, мастер берёт вызов.</h1>
</section>

<ol class="steps">
  <li>
    <span class="step-n">1</span>
    <span class="step-name">Заявка</span>
    <span class="step-note">Клиент пишет</span>
  </li>
  <li>
    <span class="step-n">2</span>
    <span class="step-name">Объект</span>
    <span class="step-note">Прораб ведёт</span>
  </li>
  <li>
    <span class="step-n">3</span>
    <span class="step-name">Мастер</span>
    <span class="step-note">Берёт вызов</span>
  </li>
</ol>

<div class="catalog">
  <section class="entry">
    <div class="entry-top">
      <h2>Клиент</h2>
      <p class="entry-price num">0 ₽</p>
    </div>
    <p class="entry-out">Заявка и статус</p>
    <a class="btn" href="/register?role=client">Оставить заявку</a>
  </section>
  <section class="entry">
    <div class="entry-top">
      <h2>Прораб</h2>
      <p class="entry-price num"><%= formatMoney(PRICES.objectRub) %> <span>за квартиру</span></p>
    </div>
    <p class="entry-out">Этапы, долг, фото</p>
    <a class="btn" href="/register?role=foreman">Вести квартиру</a>
  </section>
  <section class="entry">
    <div class="entry-top">
      <h2>Мастер</h2>
      <p class="entry-price num"><%= formatMoney(PRICES.masterMonthRub) %> <span>в месяц</span></p>
    </div>
    <p class="entry-out">Входящие вызовы.</p>
    <a class="btn" href="/register?role=master">Брать вызовы</a>
  </section>
</div>
<p class="pay-note">Оплата не подключена. Деньги не списываются.</p>
<%- include('partials/demo') %>
<%- include('partials/foot') %>
