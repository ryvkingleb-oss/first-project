<%- include('partials/head', { title, home: true }) %>

<section class="home-tiles" aria-label="Кто вы">
  <article class="home-tile home-tile-foreman">
    <%- include('partials/drawing', { role: 'foreman' }) %>
    <p class="kicker">Прораб</p>
    <h2>Я прораб</h2>
    <p>Ищете мастера и даёте задачу: специальность, адрес и что сделать. Потом видите, кто откликнулся.</p>
    <p class="home-price"><span class="num"><%= formatMoney(PRICES.objectRub) %></span> <span class="home-unit">за объект</span></p>
    <div class="home-actions">
      <a class="btn" href="/register/foreman">Регистрация</a>
      <a class="btn secondary" href="/login/foreman">Войти</a>
    </div>
  </article>
  <article class="home-tile home-tile-master">
    <%- include('partials/drawing', { role: 'master' }) %>
    <p class="kicker">Мастер</p>
    <h2>Я мастер</h2>
    <p>Видите открытые задачи своей специальности и откликаетесь. Взятые задачи остаются в кабинете.</p>
    <p class="home-price"><span class="num"><%= formatMoney(PRICES.masterMonthRub) %></span> <span class="home-unit">в месяц за входящие</span></p>
    <div class="home-actions">
      <a class="btn" href="/register/master">Регистрация</a>
      <a class="btn secondary" href="/login/master">Войти</a>
    </div>
  </article>
</section>
<%- include('partials/foot') %>
