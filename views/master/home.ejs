<%- include('../partials/head', { title, board: true }) %>
<%
  var current = null;
  mine.forEach(function (item) {
    if (!current && item.job_status !== 'done') current = item;
  });
  function tone(offer) {
    if (!offer || offer.status === 'cancelled') return 'cancelled';
    if (offer.status === 'open') return 'open';
    if (offer.job_status === 'in_progress') return 'in_progress';
    if (offer.job_status === 'done') return 'done';
    return 'accepted';
  }
%>
<p class="kicker"><%= SPECIALTIES[user.specialty] %></p>
<h1><%= user.full_name %></h1>
<dl class="facts">
  <div>
    <dt>Телефон</dt>
    <dd><a class="tel" href="tel:+<%= user.phone %>"><%= formatPhone(user.phone) %></a></dd>
  </div>
  <div>
    <dt>Специальность</dt>
    <dd><%= SPECIALTIES[user.specialty] %></dd>
  </div>
</dl>
<p class="pay-note"><%= formatMoney(price) %> в месяц. Оплата не проводится. Деньги не списываются.</p>
<form method="post" action="/master/accepting" class="switch">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="accepting_orders" value="<%= user.accepting_orders ? '0' : '1' %>">
  <span><% if (user.accepting_orders) { %>Сейчас вы принимаете заказы.<% } else { %>Приём выключен.<% } %></span>
  <button class="btn<%= user.accepting_orders ? ' secondary' : '' %>" type="submit"><%= user.accepting_orders ? 'Пауза' : 'Принимаю заказы' %></button>
</form>

<% if (current) { %>
  <article class="focus">
    <p class="kicker">Сейчас</p>
    <h2><a href="/master/offers/<%= current.id %>"><%= current.address %></a></h2>
    <p><span class="tag lg tag-<%= tone(current) %>"><%= offerLabel(current) %></span></p>
    <p><%= current.summary %></p>
    <p class="meta"><%= current.contact_name %> · <a class="tel" href="tel:+<%= current.contact_phone %>"><%= formatPhone(current.contact_phone) %></a></p>
    <form method="post" action="/master/offers/<%= current.id %>/status" class="stack">
      <%- include('../partials/csrf') %>
      <fieldset>
        <legend>Статус</legend>
        <label class="choice"><input type="radio" name="job_status" value="accepted" <%= current.job_status === 'accepted' ? 'checked' : '' %>> Принят</label>
        <label class="choice"><input type="radio" name="job_status" value="in_progress" <%= current.job_status === 'in_progress' ? 'checked' : '' %>> В работе</label>
        <label class="choice"><input type="radio" name="job_status" value="done" <%= current.job_status === 'done' ? 'checked' : '' %>> Готово</label>
      </fieldset>
      <div class="field">
        <label for="status_note">Заметка</label>
        <textarea id="status_note" name="status_note" maxlength="500"><%= current.status_note || '' %></textarea>
      </div>
      <button class="btn" type="submit">Сохранить</button>
    </form>
  </article>
<% } %>

<% var restMine = mine.filter(function (item) { return !current || item.id !== current.id; }); %>
<% if (!mine.length) { %>
  <section class="sec">
    <h2>Мои заказы</h2>
    <p class="empty">Принятых заказов нет.</p>
  </section>
<% } else if (restMine.length) { %>
  <section class="sec">
    <h2>Мои заказы</h2>
    <div class="rows">
      <% restMine.forEach(function (item) { %>
        <a class="row" href="/master/offers/<%= item.id %>">
          <span class="row-title"><%= item.address %></span>
          <span class="tag tag-<%= tone(item) %>"><%= offerLabel(item) %></span>
          <span class="row-next"><%= item.summary %></span>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="sec">
  <h2>Входящие</h2>
  <% if (!user.accepting_orders) { %>
    <p class="empty">Включите приём, чтобы видеть новые вызовы.</p>
  <% } else if (!incoming.length) { %>
    <p class="empty">Новых вызовов нет.</p>
  <% } else { %>
    <div class="rows">
      <% incoming.forEach(function (item) { %>
        <a class="row" href="/master/offers/<%= item.id %>">
          <span class="row-title"><%= item.address %></span>
          <span class="row-go">Открыть</span>
          <span class="row-meta"><%= item.contact_name %></span>
          <span class="row-next"><%= item.summary %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
