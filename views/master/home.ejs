<%- include('../partials/head', { title, board: true }) %>
<p class="kicker"><%= SPECIALTIES[user.specialty] %></p>
<h1>Задачи</h1>

<% if (!user.orders_opened_unpaid) { %>
  <p class="price num"><%= formatMoney(price) %></p>
  <p class="price-unit">в месяц за входящие</p>
  <p class="notice">Оплата не проводится. Деньги не списываются.</p>
  <p class="actions"><a class="btn" href="/master/subscription">Открыть входящие</a></p>
<% } else { %>
  <p class="pay-note">Входящие без оплаты. <%= formatMoney(price) %> в месяц. Деньги не списаны.</p>
  <form method="post" action="/master/accepting" class="switch">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="accepting_orders" value="<%= user.accepting_orders ? '0' : '1' %>">
    <span><% if (user.accepting_orders) { %>Сейчас вы видите новые задачи.<% } else { %>Приём выключен.<% } %></span>
    <button class="btn<%= user.accepting_orders ? ' secondary' : '' %>" type="submit"><%= user.accepting_orders ? 'Пауза' : 'Показывать задачи' %></button>
  </form>
<% } %>

<% if (user.orders_opened_unpaid && user.accepting_orders) { %>
  <section class="sec">
    <h2>Открытые</h2>
    <% if (!openTasks.length) { %>
      <p class="empty">Новых задач вашей специальности нет.</p>
    <% } else { %>
      <div class="rows">
        <% openTasks.forEach(function (item) { %>
          <a class="row" href="/master/tasks/<%= item.id %>">
            <span class="row-title"><%= item.address %></span>
            <span class="row-go">Отклик</span>
            <span class="row-meta"><%= item.foreman_name %></span>
            <span class="row-next"><%= item.summary %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
<% } else if (user.orders_opened_unpaid) { %>
  <p class="empty">Включите приём, чтобы видеть новые задачи.</p>
<% } %>

<section class="sec">
  <h2>Мои отклики</h2>
  <% if (!mine.length) { %>
    <p class="empty">Вы ещё не откликались.</p>
  <% } else { %>
    <div class="rows">
      <% mine.forEach(function (item) { %>
        <a class="row" href="/master/tasks/<%= item.id %>">
          <span class="row-title"><%= item.address %></span>
          <span class="row-go">Ваш</span>
          <span class="row-next"><%= item.summary %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
<%- include('../partials/foot') %>
