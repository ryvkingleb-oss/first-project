# Публичный URL сайта без хвоста /
SITE_URL=https://documentmigrant.ru

# Слушать на docker-gateway, чтобы Caddy из контейнера достучался
HOST=172.18.0.1
PORT=8787

# Секрет сессий (случайная длинная строка)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# 1 за HTTPS (прод), 0 для локального http
COOKIE_SECURE=1

# Цена услуги «уведомление о прибытии», рубли
PRICE_RUB=490

# Яндекс.Метрика
METRIKA_ID=113097423

# ЮKassa (если пусто — тестовый режим без списания)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://documentmigrant.ru/kabinet

# Уведомления админу
ADMIN_EMAIL=support@documentmigrant.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Хранение черновиков
DATA_DIR=data
PDN_RETENTION_DAYS=90
