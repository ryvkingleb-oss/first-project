<section class="hero">
  <p class="kicker">Кабинет</p>
  <h1><%= mode === 'register' ? 'Регистрация' : 'Вход' %></h1>
  <p class="lead"><%= mode === 'register' ? 'Создайте кабинет: сохраните черновик и скачивайте файлы после оплаты.' : 'Войдите, чтобы продолжить заполнение и скачать файлы.' %></p>
</section>
<form class="sheet stack" method="post" action="<%= mode === 'register' ? '/registraciya' : '/vhod' %>" style="max-width:28rem">
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <% if (mode === 'register') { %>
    <div class="field"><label for="name">Как к вам обращаться</label><input id="name" name="name" required minlength="2" autocomplete="name" /></div>
  <% } %>
  <div class="field"><label for="email">Почта</label><input id="email" name="email" type="email" required autocomplete="email" /></div>
  <div class="field"><label for="password">Пароль</label><input id="password" name="password" type="password" required minlength="8" autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" /></div>
  <input type="hidden" name="next" value="<%= next || '/kabinet' %>" />
  <button class="btn" type="submit"><%= mode === 'register' ? 'Создать кабинет' : 'Войти' %></button>
  <p class="muted">
    <% if (mode === 'register') { %>
      Уже есть кабинет? <a href="/vhod">Войти</a>
    <% } else { %>
      Нет кабинета? <a href="/registraciya">Регистрация</a>
    <% } %>
  </p>
</form>
